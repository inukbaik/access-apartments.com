# Copy to .env and fill in. Values come from /costar-keys in the CoStar track Discord.
# Never commit .env.

# Matterport Model API (HTTP basic auth: key = username, token = password)
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=

# Vexcel API (X-API-KEY header; Houston and LA only)
VEXCEL_API_KEY=

# Password for costar-hackathon-kit.zip (CoStar property records)
COSTAR_ZIP_PASSWORD=

# Optional: download link for the CoStar kit (also given by /costar-keys)
COSTAR_KIT_URL=

# Finder agent (finder/ask.py): any OpenAI-compatible LLM server. Defaults: local Ollama, qwen3:8b.
# Optional: FINDER_LLM_REASONING_EFFORT (default "none" for qwen3; "off" sends nothing).
FINDER_LLM_BASE_URL=
FINDER_LLM_MODEL=
FINDER_LLM_API_KEY=
