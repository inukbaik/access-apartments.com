# Copy to .env and fill in. Values come from /costar-keys in the CoStar track Discord.
# Never commit .env.

# Matterport Model API (HTTP basic auth: key = username, token = password)
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=

# Vexcel API (X-API-KEY header; Houston and LA only)
VEXCEL_API_KEY=

# Password for costar-hackathon-kit.zip (CoStar property records)
COSTAR_ZIP_PASSWORD=
